# Required: Google AI Studio API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Optional: Gemini image model to use
GEMINI_MODEL=gemini-2.5-flash-image

# Optional: Flask secret key. A random one is generated per process if unset.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Optional limits
MAX_IMAGES=5
MAX_UPLOAD_MB=16
MAX_PROMPT_CHARS=2000

# Development server only (python -m nano_banana)
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
